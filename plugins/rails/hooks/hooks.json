{
  "description": "Mistake catchers: the destructive-command guard denies or stays silent; the git guard judges pushes, optional commit style and pipelines into shells (including unreadable pipeline text). Pipeline review is a fixed ask in the floor hook only, a deny when unattended; the stored-options hook stays silent on that class. Neither guard ever returns an allow.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env",
            "args": ["-u", "BASH_ENV", "-u", "ENV", "/bin/bash", "--noprofile", "--norc", "-p", "${CLAUDE_PLUGIN_ROOT}/hooks/destructive-command-guard.sh"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking destructive command guardrails..."
          },
          {
            "type": "command",
            "command": "/usr/bin/env",
            "args": ["-u", "BASH_ENV", "-u", "ENV", "/bin/bash", "--noprofile", "--norc", "-p", "${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.sh",
                     "--push-to-main", "ask", "--force-push", "ask", "--commit-style", "off"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking git guardrails..."
          },
          {
            "type": "command",
            "command": "/usr/bin/env",
            "args": ["-u", "BASH_ENV", "-u", "ENV", "/bin/bash", "--noprofile", "--norc", "-p", "${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.sh",
                     "--tighten-only",
                     "--push-to-main", "${user_config.push_to_main}",
                     "--force-push", "${user_config.force_push}",
                     "--commit-style", "${user_config.commit_style}"],
            "timeout": 10,
            "statusMessage": "Checking stored git guard options..."
          }
        ]
      }
    ]
  }
}
